{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "server.app:app",
      "functions": {
        "server/app.py": {
          "maxDuration": 300,
          "excludeFiles": "{web/**,tests/**,eval/**,docs/**,scripts/**,.venv/**,.github/**,.claude/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
