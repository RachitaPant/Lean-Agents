# Copy to .env and fill in. Never commit .env.

# LLM providers (free tiers)
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Upstash Redis (plan cache, rate limiting, budget)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local dev (optional)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Demo protection
DAILY_TOKEN_BUDGET=150000
PER_IP_RUNS_PER_HOUR=5
