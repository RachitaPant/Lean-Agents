# Copy to .env and fill in. Never commit .env.

# LLM providers (free tiers)
GROQ_API_KEY=
# Fallback 1: Google AI Studio (no card). OpenAI-compatible base URL:
#   https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
# Fallback 2: GitHub Models (free with a GitHub account; 8K input tokens/request cap)
GITHUB_MODELS_TOKEN=

# Override model / endpoint (OpenAI-compatible) without code changes
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Upstash Redis (plan cache, rate limiting, budget)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local model (last resort only; not used by default, see CLAUDE.md)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Demo protection
DAILY_TOKEN_BUDGET=150000
PER_IP_RUNS_PER_HOUR=5
